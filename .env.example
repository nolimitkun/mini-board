# Environment configuration for Cloud VM Comparison API
# Copy this file to .env and modify the values as needed

# Database settings
DB_PATH=vm_catalog.duckdb
DATA_DIR=v8

# API settings
API_HOST=0.0.0.0
API_PORT=8000

# Logging settings
LOG_LEVEL=INFO

# GitHub repository settings (usually don't need to change)
SKYPILOT_CATALOG_URL=https://github.com/skypilot-org/skypilot-catalog/tree/master/catalogs/v8

# CORS settings
# Comma-separated list of allowed origins, or "*" for any origin.
# Credentials are auto-enabled only when explicit origins are set (the CORS
# spec forbids credentials with a wildcard origin).
CORS_ORIGINS=*
