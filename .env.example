# Environment configuration for Cloud VM Comparison API
# Copy this file to .env and modify the values as needed

# Database settings
DB_PATH=vm_catalog.duckdb
DATA_DIR=v7

# API settings
API_HOST=0.0.0.0
API_PORT=8000

# Logging settings
LOG_LEVEL=INFO

# GitHub repository settings (usually don't need to change)
SKYPILOT_CATALOG_URL=https://github.com/skypilot-org/skypilot-catalog/tree/master/catalogs/v7

# CORS settings (for production, specify allowed origins)
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
